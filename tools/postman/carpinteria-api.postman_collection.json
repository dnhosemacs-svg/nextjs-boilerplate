            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fantasma\"\n}"
            },
            "url": "{{baseUrl}}/api/products/{{fakeId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 — Materials stock (2.1)",
      "item": [
        {
          "name": "felices",
          "item": [
            {
              "name": "200 — GET material stock",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const body = pm.response.json();",
                      "  pm.collectionVariables.set('stockPhysicalBefore', body.physical);",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Cookie", "value": "{{cookie}}" }
                ],
                "url": "{{baseUrl}}/api/materials/{{materialId}}/stock"
              },
              "response": []
