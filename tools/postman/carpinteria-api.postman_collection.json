              "mode": "raw",
              "raw": "{\n  \"name\": \"Sin categoría\",\n  \"price\": 5,\n  \"categoryId\": \"{{fakeId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/products"
          },
          "response": []
        },
        {
          "name": "404 — PATCH product id inexistente",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Cookie", "value": "{{cookie}}" },
