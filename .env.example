# Copia este archivo a ".env.local" y rellena los valores (no subas .env.local al repo).

# --- Firebase: servidor (login email/contraseña vía REST en NextAuth) ---
# Firebase Console → Configuración del proyecto → General → "Clave de API web".
# Solo servidor: sin prefijo NEXT_PUBLIC_ (no llega al navegador).
FIREBASE_API_KEY=

# --- Firebase: cliente (registro con SDK en el navegador) ---
# Misma pantalla de Firebase: copia apiKey, authDomain y projectId del objeto firebaseConfig.
# NEXT_PUBLIC_* se incluyen en el bundle del frontend (es normal para Firebase; restringe la clave en Google Cloud).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- NextAuth ---
# NEXTAUTH_SECRET=
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GITHUB_ID=
# GITHUB_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
