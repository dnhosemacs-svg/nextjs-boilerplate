# Copia este archivo a ".env.local" y rellena los valores (no subas .env.local al repo).

# --- NextAuth ---
# Genera un secreto seguro, por ejemplo: openssl rand -base64 32
# También se acepta AUTH_SECRET como alias de NEXTAUTH_SECRET.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- GitHub OAuth (opcional: ambas vacías o ambas definidas) ---
# Developer settings → OAuth Apps → Authorization callback URL:
#   http://localhost:3000/api/auth/callback/github
# En producción añade también: https://tu-dominio.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# --- Registro público (/register) ---
# "false" = no hay alta libre; solo admin crea cuentas (API en pasos posteriores).
PUBLIC_REGISTRATION_ENABLED=true

# --- Firebase: servidor (login email/contraseña vía REST en NextAuth) ---
# Firebase Console → Configuración del proyecto → General → "Clave de API web".
# Solo servidor: sin prefijo NEXT_PUBLIC_ (no llega al navegador).
FIREBASE_API_KEY=

# --- Firebase: cliente (registro con SDK en el navegador) ---
# Misma "Clave de API web" que FIREBASE_API_KEY. Restringe la clave en Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Rellena desde Firebase Console → Configuración → General → firebaseConfig:
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id

# --- Firebase Admin (servidor: alta de usuarios por ADMIN) ---
# Firebase Console → Configuración → Cuentas de servicio → Generar nueva clave privada.
# FIREBASE_PROJECT_ID es opcional si ya tienes NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pega la clave en una línea; los saltos de línea como \n literales.
FIREBASE_PRIVATE_KEY=

# --- PostgreSQL (Neon) ---
# Dashboard Neon → Connect → Connection pooling ON → copiar URL completa
DATABASE_URL=
# Dashboard Neon → Connect → Connection pooling OFF → copiar URL completa (migraciones Prisma)
DIRECT_URL=

# --- Demo desarrollo (tarjeta 4.4) ---
# Si es "true", PATCH /api/products/:id/stock responde 500 para probar rollback en UI.
# Solo en .env.local; no activar en producción.
# DEMO_STOCK_500=true
