# Copia este archivo a ".env.local" y rellena los valores (no subas .env.local al repo).

# --- Firebase (Identity Toolkit REST: signInWithPassword) ---
# Firebase Console → tu proyecto → engranaje "Configuración del proyecto" → General.
# En "Tus apps" o en la sección de la API, usa la "Clave de API web" (Web API Key).
# Solo servidor: no uses el prefijo NEXT_PUBLIC_ salvo que de verdad la expongas al navegador.
FIREBASE_API_KEY=

# --- NextAuth (ya usados en el proyecto) ---
# NEXTAUTH_SECRET=
# AUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GITHUB_ID=
# GITHUB_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
