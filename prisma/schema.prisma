// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  WORKER
  CLIENT
}

enum MaterialUnit {
  M
  M2
  UD
  L
  KG
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  RESERVE
  RELEASE
}

enum OrderStatus {
  DRAFT
  PENDING
  APPROVED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      UserRole @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockMovements StockMovement[]
  clientOrders   Order[]         @relation("OrderClient")

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  materials Material[]

  @@map("categories")
}

model Material {
  id          String   @id @default(cuid())
  name        String
  sku         String?  @unique
  unit        MaterialUnit
  unitCost    Decimal  @db.Decimal(10, 2)
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  minStock    Decimal  @default(0) @db.Decimal(12, 3)
  location    String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockMovements     StockMovement[]
  orderMaterialLines OrderMaterialLine[]
  reservations       OrderReservation[]

  @@index([categoryId])
  @@map("materials")
}

model StockMovement {
  id         String            @id @default(cuid())
  type       StockMovementType
  quantity   Decimal           @db.Decimal(12, 3)
  reason     String?

  materialId String
  material   Material          @relation(fields: [materialId], references: [id], onDelete: Restrict)

  orderId    String?
  order      Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  userId     String?
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt  DateTime          @default(now())

  @@index([materialId])
  @@index([orderId])
  @@index([userId])
  @@map("stock_movements")
}

model Order {
  id            String      @id @default(cuid())
  clientId      String
  client        User        @relation("OrderClient", fields: [clientId], references: [id], onDelete: Restrict)
  status        OrderStatus @default(DRAFT)
  furnitureType String
  parameters    Json
  notes         String?
  hasShortages  Boolean     @default(false)
  shortages     Json?
  laborAmount   Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  materialLines   OrderMaterialLine[]
  reservations    OrderReservation[]
  stockMovements  StockMovement[]

  @@index([clientId])
  @@index([status])
  @@map("orders")
}

model OrderMaterialLine {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId       String
  material         Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  plannedQty       Decimal  @db.Decimal(12, 3)
  actualQty        Decimal? @db.Decimal(12, 3)
  unitCostSnapshot Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([materialId])
  @@map("order_material_lines")
}

model OrderReservation {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity   Decimal  @db.Decimal(12, 3)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderId])
  @@index([materialId])
  @@map("order_reservations")
}
